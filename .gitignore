node_modules/
.expo/
.vite/
dist/
build/
tmp/

.DS_Store
.idea/
.worktrees/
tests/install/*logs*
test-results/
playwright-report/
playwright/.cache/
tests/install/todo-install-logs/
scripts/ota-e2e/ota-dry-run-logs/
scripts/ota-e2e/ota-crash-rollback-logs/

# Local secrets — never commit
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# The vendored PocketBase fork is source we ship, not build output, so it is exempt
# from the rules above — ui/dist would otherwise be swept up by `dist/`, and it is
# tracked upstream and consumed by a //go:embed all:dist directive, so excluding it
# breaks the Go build outright. Placed after the secret rules so it overrides them
# for this subtree only.
!third_party/pocketbase/**

# The admin UI's build inputs (ui/src, ui/public, the 4.2M dprint WASM formatter,
# vite/npm config) are NOT vendored: Go embeds only the prebuilt ui/dist, so they
# cost ~8M for a toolchain we never run. Re-fetch from upstream if the admin console
# ever needs rebuilding from source.
third_party/pocketbase/ui/src/
third_party/pocketbase/ui/public/
third_party/pocketbase/ui/*.wasm
third_party/pocketbase/ui/package*.json
third_party/pocketbase/ui/dprint.json
third_party/pocketbase/ui/vite.config.js
third_party/pocketbase/ui/index.html

# Build artifacts
*.tsbuildinfo
tsconfig.tsbuildinfo
*.tmp.js

# Local Claude Code / superpowers state
.claude/settings.local.json
.claude/scheduled_tasks.lock
.superpowers/

# Local PocketBase data
server/pb_data/
server/pb_test_data/
# Per-org data dirs for the multi-org e2e stack (scripts/e2e-multi-org.ts),
# one seeded DB per org.
server/pb_test_data_*/
# Promoted web bundle the e2e static-serve flow (scripts/e2e-serve.ts) builds.
server/pb_test_releases/

# Copied by `pnpm run assets:copy-pdfjs` from node_modules at install time.
/public/workers/

# Generated by the package generator (route re-exports for linked feature packages)
/app/\(app\)/*/
!/app/\(app\)/settings/
!/app/\(app\)/help/
!/app/\(app\)/admin/
# Public package routes — one subtree per package with publicRoutes in its
# manifest. Fully generator-owned; the hand-written _layout.tsx sits one level
# up at app/p/_layout.tsx and stays tracked.
/app/p/*/
# oauth is app-shell/core functionality (the device-consent screen), not a
# generated package subtree — keep it tracked like settings/help/admin above.
!/app/p/oauth/
/lib/generated/
/tinycld.config.ts
/tinycld.seeds.ts
/server/package_extensions.go
/server/package_extensions_tenant.go
/server/go.work
/server/go.work.sum
/server/bundled-packages.json
/server/pb_migrations_owner.json
/server/pb_migrations/
/server/pb_hooks/
/server/tinycld
/server/app
/server/core
/server/pb_data/
/installed-packages.json
/.package-links.json

# Transient release artifacts written into the app member by CI/deploy tooling
# right before `docker build` (never committed).
/.release-id
/.release-manifest

# Native projects — regenerated on demand by `expo prebuild`.
# Anchored to the repo root so local Expo modules' own native dirs
# (e.g. modules/app-updater/ios/) stay tracked.
/ios/
/android/
*.xcuserdata
*.hprof

# Design source files
*.afdesign
*.afdesign~lock~


