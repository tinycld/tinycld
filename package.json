{
    "name": "tinycld",
    "version": "0.6.3",
    "private": true,
    "type": "module",
    "main": "index.js",
    "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
    "scripts": {
        "packages:generate": "tsx scripts/generate.ts && tsx scripts/export-types.ts",
        "stage:embed": "tsx scripts/stage-embed-assets.ts",
        "assets:copy-pdfjs": "tsx scripts/copy-pdfjs-assets.ts",
        "dev": "tsx scripts/dev.ts",
        "dev:ssl": "tsx scripts/dev.ts --ssl",
        "dev:no-ssl": "tsx scripts/dev.ts --no-ssl",
        "db:reset": "tsx scripts/reset-dev-db.ts",
        "db:reset:demo": "tsx scripts/reset-demo.ts",
        "db:seed": "tsx scripts/seed-db.ts",
        "e2e:serve": "tsx scripts/e2e-serve.ts --port ${E2E_PORT:-7200} --data-dir server/pb_test_data --releases-dir server/pb_test_releases",
        "e2e:serve:second": "tsx scripts/e2e-serve.ts --port ${E2E_PORT_2:-7201} --data-dir server/pb_test_data_2 --releases-dir server/pb_test_releases_2 --mirror-releases-from server/pb_test_releases",
        "typecheck": "tinycld-pkg typecheck",
        "lint": "tsx scripts/lint.ts",
        "lint:fix": "tsx scripts/lint.ts --write",
        "check:core-isolation": "tsx scripts/check-core-isolation.ts",
        "checks": "pnpm run lint && pnpm run typecheck && pnpm run check:core-isolation",
        "test": "tinycld-pkg test",
        "test:e2e": "tinycld-pkg test:e2e",
        "test:e2e:ota": "tsx scripts/ota-e2e/run-ota-e2e.ts",
        "test:e2e:ota:rollback": "tsx scripts/ota-e2e/run-ota-crash-rollback.ts",
        "test:server": "tsx scripts/test-server-api.ts",
        "check": "tinycld-pkg check",
        "pkg:test:unit": "tinycld-pkg test --all",
        "pkg:check": "tinycld-pkg check --all",
        "pkg:test:e2e": "tinycld-pkg test:e2e --all",
        "ssl:generate": "scripts/generate-ssl.sh",
        "simulator": "scripts/ios-simulator.sh",
        "simulator:ios": "scripts/ios-simulator.sh",
        "simulator:android": "scripts/android-simulator.sh",
        "export:web": "expo export --platform web",
        "export:ios": "expo export --platform ios",
        "export:android": "expo export --platform android",
        "android:run": "bash -c 'export JAVA_HOME=\"$(/usr/libexec/java_home -v 17 2>/dev/null || echo \"$JAVA_HOME\")\" && export PATH=\"$JAVA_HOME/bin:$PATH\" && expo run:android'",
        "eas-build-post-install": "export EXPO_PUBLIC_GIT_COMMIT=$EAS_BUILD_GIT_COMMIT_HASH && pnpm run packages:generate && pnpm run assets:copy-pdfjs"
    },
    "expo": {
        "install": {
            "exclude": [
                "react-native-gesture-handler"
            ]
        }
    },
