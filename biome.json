{
    "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
    "root": false,
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true,
        "root": "."
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "**/*.ts",
            "**/*.tsx",
            "**/*.js",
            "**/*.jsx",
            "**/*.json",
            "!server",
            "!server/**/*",
            "!**/pb_test_data",
            "!types",
            "!lib/generated",
            "!node_modules",
            "!node_modules/**/*",
            "!app/a/\\[orgSlug\\]/calendar",
            "!app/a/\\[orgSlug\\]/contacts",
            "!app/a/\\[orgSlug\\]/drive",
            "!app/a/\\[orgSlug\\]/mail",
            "!app/share/\\[token\\].tsx",
            "!**/routes.d.ts",
            "!.expo",
            "!.one",
            "!.claude",
            "!ideas",
            "!**/core/types/pbSchema.ts",
            "!**/core/types/pbZodSchema.ts",
            "!**/server",
            "!**/server/**/*",
            "!**/pb-migrations",
            "!**/pb-migrations/**/*",
            "!**/pb-hooks",
            "!**/pb-hooks/**/*",
            "!**/node_modules",
            "!**/node_modules/**/*",
            "!**/.claude",
            "!**/.claude/**/*",
            "!**/.worktrees",
            "!**/.worktrees/**/*",
            "!**/.superpowers",
            "!**/.superpowers/**/*",
            "!**/dist",
            "!**/dist/**/*",
            "!**/dist-ios",
            "!**/dist-ios/**/*",
            "!**/dist-android",
            "!**/dist-android/**/*",
            "!**/builds/**/native",
            "!**/builds/**/native/**/*",
            "!**/test-results",
            "!**/test-results/**/*",
            "!**/webview-editor/build",
            "!**/webview-editor/build/**/*"
        ]
    },
    "plugins": [
        {
            "path": "./biome-plugins/pbtsdb-no-raw-pb-access.grit",
            "includes": [
                "**/*.ts",
                "**/*.tsx",
                "!**/*.spec.ts",
                "!**/*.test.ts",
                "!**/*.test.tsx",
                "!**/tests/**",
                "!**/__tests__/**",
                "!**/scripts/**",
                "!**/seed.ts",
                "!**/seed-db.ts",
                "!**/*.seed.ts",
                "!**/core/lib/mutations.ts",
                "!**/core/lib/pocketbase.ts"
            ]
        },
        {
            "path": "./biome-plugins/pbtsdb-no-rest-collections-write.grit",
            "includes": [
                "**/*.ts",
                "**/*.tsx",
                "!**/*.spec.ts",
                "!**/*.test.ts",
                "!**/*.test.tsx",
                "!**/tests/**",
                "!**/__tests__/**",
                "!**/scripts/**"
            ]
        }
    ],
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": {
                "useConst": "error",
                "useTemplate": "error",
                "useShorthandFunctionType": "error",
                "useConsistentArrayType": {
                    "level": "error",
                    "options": {
                        "syntax": "shorthand"
                    }
                }
            },
            "correctness": {
                "useExhaustiveDependencies": "warn",
                "useHookAtTopLevel": "error",
                "noUnusedVariables": "error"
            },
            "suspicious": {
                "noDebugger": "error",
                "noConsole": "warn",
                "noVar": "error",
                "noExplicitAny": "error"
            },
            "complexity": {
                "noExcessiveCognitiveComplexity": {
                    "level": "warn",
                    "options": {
                        "maxAllowedComplexity": 45
                    }
                }
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "quoteProperties": "asNeeded",
            "trailingCommas": "es5",
            "semicolons": "asNeeded",
            "arrowParentheses": "asNeeded"
        }
    },
    "overrides": [
        {
            "includes": [
                "**/scripts/**/*",
                "**/tests/**/*",
                "**/*.test.ts",
                "**/*.test.tsx",
                "**/package-scripts/**/*"
            ],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "off"
                    },
                    "style": {
                        "noNonNullAssertion": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/core/lib/nav-perf.ts", "**/core/lib/bundle-sentinel.tsx"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "off"
                    }
                }
            }
        }
    ],
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
