// Flags raw PocketBase writes that bypass pbtsdb. A pbtsdb collection (from
// useStore()) is mutated with `.insert()/.update()` on the collection variable
// directly; the raw PB client is reached via `pb.collection('x')` and exposes
// `.create()/.update()/.delete()`. Matching the `.collection(...)` accessor with
// a write method therefore catches the raw path without flagging pbtsdb usage.
//
// Legitimate exceptions (seed scripts, test fixtures, one-off scripts) are
// excluded by the plugin's `includes` globs in biome.json. The remaining genuine
// in-app exception is a multipart FormData upload (pbtsdb's optimistic transaction
// can't carry a file blob) — those few sites are excluded by path in biome.json.
//
// See CLAUDE.md → "Data Queries & Mutations".
`$obj.collection($name).$method($args)` where {
    $method <: or { `create`, `update`, `delete` },
    register_diagnostic(
        span = $method,
        message = "Raw PocketBase write (pb.collection(...).create/update/delete) bypasses pbtsdb. Use a useMutation generator from @tinycld/core/lib/mutations.",
        severity = "error"
    )
}
