{
    "expo": {
        "name": "TinyCld",
        "slug": "tinycld",
        "version": "2.0.2",
        "scheme": "tinycld",
        "platforms": ["ios", "android", "web"],
        "userInterfaceStyle": "automatic",
        "plugins": [
            [
                "expo-router",
                {
                    "asyncRoutes": {
                        "web": "production",
                        "default": false
                    }
                }
            ],
            [
                "expo-image-picker",
                {
                    "photosPermission": "Allow TinyCld to access your photos so you can upload them to Drive."
                }
            ],
            "expo-sharing",
            [
                "@sentry/react-native/expo",
                {
                    "organization": "argosity",
                    "project": "tinycld"
                }
            ],
            [
                "expo-dev-client",
                {
                    "toolsButton": false
                }
            ],
            "./plugins/with-app-updater.cjs"
        ],
        "icon": "./assets/app-icon.png",
        "splash": {
            "image": "./assets/app-splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#445E82"
        },
        "ios": {
            "bundleIdentifier": "org.tinycld.app",
            "supportsTablet": true,
            "associatedDomains": ["applinks:tinycld.org"],
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false,
                "NSPhotoLibraryAddUsageDescription": "Allow TinyCld to save downloaded images to your Photos library."
            }
        },
        "android": {
            "package": "org.tinycld.app",
            "intentFilters": [
                {
                    "action": "VIEW",
                    "autoVerify": true,
                    "data": [
                        {
                            "scheme": "https",
                            "host": "tinycld.org",
                            "pathPrefix": "/demo"
                        }
                    ],
                    "category": ["BROWSABLE", "DEFAULT"]
                }
            ],
            "permissions": ["android.permission.RECORD_AUDIO"]
        },
        "web": {
            "bundler": "metro",
            "output": "single"
        },
        "experiments": {
            "typedRoutes": true
        },
        "extra": {
            "router": {
                "asyncRoutes": {
                    "web": "production",
                    "default": false
                }
            },
            "eas": {
                "projectId": "ac921362-6d8a-49a4-b0a5-d5867617bc4d"
            }
        },
        "owner": "nathanstitt"
    }
}
